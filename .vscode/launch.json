{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Run Copilot App",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Python: Run Evaluation Suite",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/train_and_evaluate.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Run Automated Tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_api.py",
      "console": "integratedTerminal"
    }
  ]
}
